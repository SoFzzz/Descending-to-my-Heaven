{
  "mcpServers": {
    "godot": {
      "command": "node",
      "args": ["${GODOT_MCP_DIR:-D:/mcp-servers/godot}/node_modules/@coding-solo/godot-mcp/build/index.js"],
      "env": {
        "GODOT_PATH": "${GODOT_PATH:-D:/Godot_v4.7.2-stable_win64.exe/Godot_v4.7.2-stable_win64_console.exe}"
      }
    },
    "blender": {
      "command": "${BLENDER_MCP_EXE:-D:/mcp-servers/blender/Scripts/mcp-for-blender.exe}",
      "args": [],
      "env": {
        "DISABLE_TELEMETRY": "true"
      }
    }
  }
}

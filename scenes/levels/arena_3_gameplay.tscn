; arena_3.tscn trae EndingCam1/EndingCam2 (Tarea 15) y, al entrar primero en el árbol, la EndingCam1 se
; quedaba como cámara activa. La cámara de Kaelen debe ser la actual durante el combate.
[node name="Camera3D" parent="Kaelen/CameraRig/SpringArm3D" index="0"]
current = true

; Sala de Elysia rota: hueco al exterior con la isla cayendo (se activa al empezar el final). Su origen
; es el centro del muro norte de la sala de Elysia (level_builder: z = -(24 + 1) - 20 - 12 - 0.5).
[node name="EndingRoom" parent="." instance=ExtResource("12_room")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, -57.5)
